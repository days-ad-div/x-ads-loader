# X Ads API（OAuth 1.0a。ad-account-registry・ad-monitor と同じトークン）
X_CONSUMER_KEY=""
X_CONSUMER_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_TOKEN_SECRET=""

# 出力先
BQ_PROJECT="days-ad-data-pipeline"
BQ_DATASET="source_dev"
# true なら BigQuery に書かず、取得した行数だけ出力する
DRY_RUN="true"

# ローカルで一部だけ試すとき（空なら台帳の全アカウント）
ACCOUNT_IDS=""
